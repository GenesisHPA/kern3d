# Токен от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=
# Как часто проверять новый релиз на GitHub, минут (по умолчанию 10)
RELEASE_POLL_MINUTES=10
# Telegram ID владельца (через запятую): только им бот отвечает на /stats в личке
OWNER_IDS=
# Ключ к сводке статистики сайта (тот же, что K3_STATS_TOKEN в /opt/gtb_site/.env)
K3_STATS_TOKEN=
